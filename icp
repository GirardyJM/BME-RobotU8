import sys
import bpy
import numpy as np
import open3d as o3d

# Ensure Blender recognizes Open3D's path
sys.path.append("/Applications/Blender.app/Contents/Resources/4.3/python/lib/python3.11/site-packages")

print("✅ Open3D and bpy loaded successfully!")

# Function to get landmark positions from Blender objects
def get_landmark_positions(landmark_names):
    positions = []
    found_objects = []
    missing_objects = []
    
    for name in landmark_names:
        obj = bpy.data.objects.get(name)
        if obj:
            positions.append(obj.location[:])  # Get (X, Y, Z)
            found_objects.append(name)
        else:
            missing_objects.append(name)
    
    # Debug: Print any missing objects
    if missing_objects:
        print(f"⚠️ Warning: Could not find these objects: {missing_objects}")
    
    print(f"✅ Found these objects: {found_objects}")
    
    return np.array(positions) if positions else np.empty((0, 3)), found_objects  # Return found objects too

# Print all available objects in the scene for reference
print("🔍 All objects in scene:")
for obj in bpy.data.objects:
    print(f"  - {obj.name}")

# Define Orbbec and Reference landmarks
orbbec_landmarks = ["POINT_D_PC", "DFL_PC", "DFM_PC", "POINT_C_PC"]
reference_landmarks = ["Distal Femur lateral", "Distal Femur medial", "Point C", "Point D"]

# Get coordinates and which objects were found
orbbec_points, found_orbbec = get_landmark_positions(orbbec_landmarks)
reference_points, found_reference = get_landmark_positions(reference_landmarks)

# Debug: Print original shapes and actual points
print(f"🔹 Orbbec points shape: {orbbec_points.shape}")  # Should be (N, 3)
print(f"🔹 Orbbec points: {orbbec_points}")
print(f"🔹 Reference points shape: {reference_points.shape}")  # Should be (N, 3)
print(f"🔹 Reference points: {reference_points}")

# Validate we have enough points for ICP
if orbbec_points.shape[0] < 3 or reference_points.shape[0] < 3:
    print("❌ Error: Need at least 3 corresponding points for reliable ICP alignment")
    exit()

# Create mapping between found objects and their indices
orbbec_indices = {name: i for i, name in enumerate(found_orbbec)}
reference_indices = {name: i for i, name in enumerate(found_reference)}

# Match landmarks based on name similarity
# This assumes reference and orbbec landmarks correspond by position in their respective lists
print("🔹 Matching landmarks:")
matched_pairs = []
for i, orbbec_name in enumerate(found_orbbec):
    # Try to find matching reference name by position or similarity
    if i < len(found_reference):
        ref_name = found_reference[i]
        matched_pairs.append((orbbec_name, ref_name))
        print(f"  Matched: {orbbec_name} ↔ {ref_name}")
        print(f"    Orbbec pos: {orbbec_points[i]}")
        print(f"    Reference pos: {reference_points[i]}")

# Make sure both point clouds have the same number of points
min_points = min(orbbec_points.shape[0], reference_points.shape[0])
if orbbec_points.shape[0] != reference_points.shape[0]:
    print(f"⚠️ Warning: Point count mismatch. Using only the first {min_points} points from each set.")
    orbbec_points = orbbec_points[:min_points]
    reference_points = reference_points[:min_points]

# Convert to Open3D format
orbbec_pcd = o3d.geometry.PointCloud()
orbbec_pcd.points = o3d.utility.Vector3dVector(orbbec_points)
reference_pcd = o3d.geometry.PointCloud()
reference_pcd.points = o3d.utility.Vector3dVector(reference_points)

# Perform ICP Alignment
threshold = 10.0  # Increase threshold to allow for larger initial distances
transformation = o3d.pipelines.registration.registration_icp(
    orbbec_pcd, reference_pcd, threshold,
    estimation_method=o3d.pipelines.registration.TransformationEstimationPointToPoint(),
    criteria=o3d.pipelines.registration.ICPConvergenceCriteria(max_iteration=5000)  # Increase iterations
)

# Debug: Print the transformation matrix
print(f"🔹 ICP Transformation Matrix:\n{transformation.transformation}")
print(f"🔹 ICP Fitness score: {transformation.fitness}")
print(f"🔹 ICP RMSE: {transformation.inlier_rmse}")

# Check if the transformation matrix is identity (no movement)
identity_matrix = np.eye(4)
if np.allclose(transformation.transformation, identity_matrix, atol=1e-3):
    print("⚠️ Warning: ICP transformation is nearly identity - alignment may not have worked!")

# Convert Orbbec points to homogeneous coordinates (X, Y, Z, 1)
if orbbec_points.shape[1] == 3:  # Ensure it has 3 columns before adding the 4th
    orbbec_homogeneous = np.hstack((orbbec_points, np.ones((orbbec_points.shape[0], 1))))  # Correctly add 4th column
    print(f"✅ Converted to homogeneous shape: {orbbec_homogeneous.shape}")  # Should be (N, 4)
else:
    print("❌ Error: orbbec_points already has 4 columns!")
    exit()

# Debug: Print shapes before matrix multiplication
print(f"🔹 Orbbec homogeneous shape: {orbbec_homogeneous.shape}")  # Should be (N, 4)
print(f"🔹 Transformation matrix shape: {transformation.transformation.shape}")  # Should be (4, 4)

# Apply the 4x4 transformation matrix
try:
    transformed_homogeneous = (transformation.transformation @ orbbec_homogeneous.T).T  # Ensure correct multiplication
    print("✅ Matrix multiplication successful!")
except Exception as e:
    print(f"❌ Matrix multiplication failed: {e}")
    exit()

# Convert back to 3D points by removing the last column (X, Y, Z)
aligned_points = transformed_homogeneous[:, :3]  # Extract only X, Y, Z
print(f"✅ Aligned points shape: {aligned_points.shape}")  # Should be (N, 3)

# Update ALL Orbbec landmarks whether they were in the ICP calculation or not
print("\n🔹 Updating ALL Orbbec landmarks:")
for name in orbbec_landmarks:
    obj = bpy.data.objects.get(name)
    if obj:
        print(f"  Found object: {name}")
        original_pos = obj.location[:]
        
        # Check if this landmark was used in the ICP calculation
        if name in orbbec_indices:
            idx = orbbec_indices[name]
            if idx < len(aligned_points):
                new_pos = aligned_points[idx].tolist()
                obj.location = new_pos
                print(f"    ✅ Updated {name} position:")
                print(f"      - FROM: {original_pos}")
                print(f"      - TO:   {new_pos}")
                print(f"      - DIFF: {np.array(new_pos) - np.array(original_pos)}")
            else:
                print(f"    ❌ Error: Index {idx} out of bounds for aligned_points with length {len(aligned_points)}")
        else:
            # This landmark wasn't used in ICP but we'll try to transform it anyway
            print(f"    ⚠️ {name} wasn't used in ICP calculation, applying transformation directly")
            pos_homogeneous = np.append(np.array(original_pos), 1.0)  # Convert to homogeneous
            transformed_pos = (transformation.transformation @ pos_homogeneous)[:3]  # Apply transformation
            obj.location = transformed_pos.tolist()
            print(f"      - FROM: {original_pos}")
            print(f"      - TO:   {transformed_pos.tolist()}")
            print(f"      - DIFF: {transformed_pos - np.array(original_pos)}")
    else:
        print(f"  ❌ Could not find object: {name}")

print("✅ ICP Alignment Complete!")

# Force Blender to refresh viewport
bpy.ops.wm.redraw_timer(type='DRAW_WIN_SWAP', iterations=1)
